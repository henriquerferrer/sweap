#!/bin/sh
# sweap-roadmap-lint — bare-name entry point for hooks/roadmap-lint.sh, the
# per-item spec gate `/milestone` runs before it dispatches anything.
#
# Same mechanism and same reason as bin/sweap-merge (read its header): the
# plugin's bin/ is on the Bash tool's PATH while the plugin is enabled, and
# `${CLAUDE_PLUGIN_ROOT}` is UNSET in a model-issued Bash call, so the plugin
# root is recovered from this script's own real path instead.
set -u

self=$0
case $self in
  */*) ;;
  *) self=$(command -v -- "$self") || exit 127 ;;
esac
n=0
while [ -L "$self" ] && [ "$n" -lt 40 ]; do
  link=$(readlink "$self") || break
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
  n=$((n + 1))
done
root=$(CDPATH='' cd -P -- "$(dirname "$self")/.." && pwd -P) || exit 1

exec /bin/bash "$root/hooks/roadmap-lint.sh" "$@"
