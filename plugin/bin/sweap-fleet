#!/bin/sh
# sweap-fleet — bare-name entry point for tools/sweap-fleet.mjs: can the
# self-hosted runner fleet run this repo's CI? JSON, read-only. The `/sweap:run`
# workflow's Resume stage, the merge-watcher and `/sweap:milestone` run it. Same resolution mechanism
# as bin/sweap-merge (read its header): the plugin root is recovered from this
# script's own real path because ${CLAUDE_PLUGIN_ROOT} is unset in a
# model-issued Bash call.
#
#   sweap-fleet [--repo owner/name] [--branch <branch>] [--warn-days <n>]
set -u

self=$0
case $self in
  */*) ;;
  *) self=$(command -v -- "$self") || exit 127 ;;
esac
n=0
while [ -L "$self" ] && [ "$n" -lt 40 ]; do
  link=$(readlink "$self") || break
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
  n=$((n + 1))
done
root=$(CDPATH='' cd -P -- "$(dirname "$self")/.." && pwd -P) || exit 1

exec node "$root/tools/sweap-fleet.mjs" "$@"
